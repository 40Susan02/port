# Environment Variables
# Copy this file to .env.local and fill in the values

# Required: Secret access code for the experience section
ACCESS_CODE=change-this-secret

# Required: Secret key for signing authentication tokens (JWT)
# Use a strong random string (at least 32 characters)
AUTH_SECRET=change-this-secret

# Optional: Upstash Redis for production rate limiting
# Without these, rate limiting uses in-memory store (not suitable for multi-instance deployments)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
